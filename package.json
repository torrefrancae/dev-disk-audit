{
  "name": "dev-disk-audit",
  "version": "0.2.0",
  "description": "Report quiet git checkouts and the disk they still hold, without double-counting nested repos.",
  "type": "module",
  "license": "MIT",
  "author": "Eldridge Torrefranca",
  "bin": {
    "disk-audit": "./bin/disk-audit"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --tsconfig tsconfig.json --test test/scan.test.ts test/patterns.test.ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torrefrancae/dev-disk-audit.git"
  },
  "bugs": {
    "url": "https://github.com/torrefrancae/dev-disk-audit/issues"
  },
  "homepage": "https://github.com/torrefrancae/dev-disk-audit#readme",
  "keywords": [
    "git",
    "disk",
    "cli",
    "worktree",
    "checkout"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
